<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <IsPackable>true</IsPackable>
  <PackageId>Personix.Options</PackageId>
  <AssemblyName>Personix.Options</AssemblyName>
  <RootNamespace>Personix.Options</RootNamespace>
  <Product>Personix.Options</Product>
  <Version>1.2.0</Version>
  <PackageReleaseNotes>1.2.0 — adds a net11.0 target alongside net10.0. No API change.</PackageReleaseNotes>
  <Authors>Pavel Kudrna</Authors>
  <Company>Personix</Company>
  <Description>Binds a configuration section to an options class, validates it with data annotations, and fails at start-up rather than on the first request that reads it. Ships a ValidPath attribute for settings that name a file or directory, so a bad path is caught while the host is still starting.</Description>
  <Copyright>Copyright (c) 2026 Personix</Copyright>
  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  <PackageProjectUrl>https://github.com/personix-org/Options</PackageProjectUrl>
  <RepositoryUrl>https://github.com/personix-org/Options</RepositoryUrl>
  <RepositoryType>git</RepositoryType>
  <PackageTags>options;configuration;validation;dependency-injection;startup;data-annotations</PackageTags>
  <PublishRepositoryUrl>true</PublishRepositoryUrl>
  <EmbedUntrackedSources>true</EmbedUntrackedSources>
  <IncludeSymbols>true</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  <Deterministic>true</Deterministic>
  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
  <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
  <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.1" />
  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.1" />
  <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.1" />
  </ItemGroup>

</Project>
